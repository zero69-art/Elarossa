# Public site configuration
NEXT_PUBLIC_SITE_URL=https://elarossa.vercel.app

# Server-only CJdropshipping API credential
# Never prefix secrets with NEXT_PUBLIC_ and never commit real values.
CJ_ACCESS_TOKEN=

# Server-only Stripe secret key
STRIPE_SECRET_KEY=

# Optional: Stripe webhook signing secret for order-event processing
STRIPE_WEBHOOK_SECRET=
