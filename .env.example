NEXT_PUBLIC_SITE_URL=https://elarossa.vercel.app

# Keep false/unset until product quality, fulfilment, legal and customer-support workflows are verified.
ELAROSSA_STORE_LIVE=false

# Server-only secrets — never expose these with NEXT_PUBLIC_.
CJ_ACCESS_TOKEN=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Gates /admin/products and the /api/cj/products* routes. Generate a long
# random string (e.g. `openssl rand -hex 32`) and keep it secret.
ADMIN_ACCESS_TOKEN=
